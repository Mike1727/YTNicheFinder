# Скопируй этот файл в .env и впиши ключ. Всё остальное можно не трогать.

# Обязательно: ключ YouTube Data API v3
YT_API_KEY=

# Язык и регион поиска (en/US, de/DE, es/MX ...)
RELEVANCE_LANGUAGE=en
REGION_CODE=US

# Пороги поиска кандидатов (необязательно)
MAX_CHANNEL_AGE_DAYS=60
MAX_SUBS=10000
MIN_OUTLIER_VIEWS=50000
MIN_VIEWS_PER_SUB=10

# Пороги проверки ниши (необязательно)
MAX_CHANNELS=30
HARD_MAX_SUBS=1000000
MIN_TOP_VIEWS=100000

# Квота YouTube: 10000 units в сутки, бюджет с запасом
DAILY_BUDGET=9000
DISCOVERY_SEARCHES=20
MAX_VALIDATIONS=15

# LLM (необязательно, без него работает эвристика по тегам и заголовкам).
# Бесплатный вариант: ключ из https://aistudio.google.com/apikey
# Название модели может устареть: проверь актуальное в AI Studio.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
